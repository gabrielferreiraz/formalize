// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // URL is configured in prisma.config.ts (for CLI) and via adapter (for runtime)
}

// ------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ARTIST_ADMIN
}

enum ArtistStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum ArtistRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  BUDGET
  CONTRACT
  PORTFOLIO
  STAGE_MAP
  GENERIC_EVENT
}

// ------------------------------------------------------------------
// Models
// ------------------------------------------------------------------

/// Tenant principal — cada artista é um tenant isolado
model Artist {
  id           String      @id @default(cuid())
  name         String
  customDomain String?     @unique
  logoUrl      String?
  backgroundUrl String?
  instruments         String?   // ex: "Bateria, Percussão, Guitarra, Baixo, Sanfona"

  primaryColor   String  @default("#000000")
  secondaryColor String  @default("#ffffff")

  whatsapp  String?
  email     String?
  instagram String?
  spotify   String?
  x         String?
  youtube   String?

  pixKey   String?
  bankInfo Json?

  website    String?
  legalName  String?
  cnpj       String?
  address    Json?

  orcamentoFontScale Int @default(100)
  contratoFontScale  Int @default(100)
  orcamentoLogoScale Int @default(100)
  contratoLogoScale  Int @default(100)
  orcamentoTemplate  String @default("orc-001")
  contratoTemplate   String @default("ctr-001")

  onboardingDone Boolean @default(false)
  categoria      String? // "banda" | "solo" | "dj" | "dupla" | "cantor" | "outros"

  planStartDate      DateTime  @default(now())
  billingCycleMonths Int       @default(1)
  planLabel          String    @default("Basic")

  status ArtistStatus @default(ACTIVE)

  /// Origem do cadastro: "LP" = veio do formulário do site, "MANUAL" = criado pelo super-admin
  source String @default("MANUAL")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  documents            Document[]
  templates            Template[]
  contratoTemplates    ContratoTemplate[]
  pdfTemplateMappings  PdfTemplateMapping[]
}

model User {
  id       String   @id @default(cuid())
  email    String   @unique
  password String
  name     String?
  role     UserRole @default(ARTIST_ADMIN)

  artistId String?
  artist   Artist? @relation(fields: [artistId], references: [id], onDelete: SetNull)

  forcePasswordChange Boolean @default(false)
  active              Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([artistId])
}

/// Documentos gerados (orçamentos, contratos, etc.)
model Document {
  id       String       @id @default(cuid())
  artistId String
  artist   Artist       @relation(fields: [artistId], references: [id], onDelete: Cascade)

  type  DocumentType
  title String

  /// URL do PDF armazenado no Cloudflare R2
  pdfUrl String?

  /// Dados estruturados do documento (campos do formulário)
  data Json

  sentAt    DateTime?
  createdAt DateTime  @default(now())

  /// Página web pública (/ver/[token]) — token opaco gerado sob demanda, nunca o id do documento
  publicToken String?   @unique
  viewedAt    DateTime?
  viewCount   Int       @default(0)
  /// Reservado para a Fase 2 (aprovação de orçamento pelo contratante)
  approvedAt  DateTime?

  @@index([artistId])
  @@index([artistId, type])
}

/// Templates HTML por artista (um por tipo de documento)
model Template {
  id       String @id @default(cuid())
  artistId String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  type DocumentType

  /// URL do template HTML armazenado no Cloudflare R2
  htmlUrl   String
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([artistId, type])
  @@index([artistId])
}

/// Token de redefinição de senha (sem SMTP — admin entrega o link via WhatsApp)
model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique @default(cuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

/// Templates de contrato com cláusulas customizáveis por artista
model ContratoTemplate {
  id        String   @id @default(cuid())
  artistId  String
  nome      String
  tipo      String   @default("custom") // "banda" | "solo" | "dj" | "generico" | "custom"
  titulo    String   @default("Contrato de Prestação de Serviços")
  clausulas Json     // ClausulaContrato[]
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId])
}

/// Templates PDF customizados por artista (canvas editor)
model PdfTemplateMapping {
  id        String   @id @default(cuid())
  artistId  String
  type      String   // "orcamento" | "contrato"
  name      String
  pdfUrl    String
  pageCount Int      @default(1)
  fields    Json     @default("[]")
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId])
}

/// Templates HTML de sistema — controla visibilidade e permite override de HTML para todos os artistas
model SystemTemplate {
  id          String   @id @default(cuid())
  slug        String   @unique  // "orc-001", "ctr-006" etc.
  type        String            // "orcamento" | "contrato"
  name        String
  description String   @default("")
  isActive    Boolean  @default(true)
  customHtml  String?  @db.Text  // HTML override — nulo = usa builder TypeScript
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Requisições de onboarding de novos artistas
model ArtistRequest {
  id         String @id @default(cuid())
  name       String
  email      String
  whatsapp   String
  artistName String

  message     String?
  categoria   String?
  temContrato Boolean @default(false)

  status        ArtistRequestStatus @default(PENDING)
  rejectedNote  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
