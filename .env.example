# ============================================================
# Formalize — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA faça commit do arquivo .env.
# ============================================================

# ----------------------------------------------------------
# Banco de Dados (PostgreSQL)
# ----------------------------------------------------------
DATABASE_URL="postgresql://formalize:formalize@localhost:5432/formalize_dev?schema=public"

# ----------------------------------------------------------
# NextAuth.js
# ----------------------------------------------------------
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET="TROQUE_POR_UM_SEGREDO_FORTE"
NEXTAUTH_URL="http://localhost:3000"

# ----------------------------------------------------------
# Domínio raiz (multi-tenant)
# Usado pelo middleware para resolver subdomínios
# ----------------------------------------------------------
NEXT_PUBLIC_ROOT_DOMAIN="formalize.com.br"

# ----------------------------------------------------------
# Cloudflare R2 (Storage) — obrigatórios em lib/r2.ts
# ----------------------------------------------------------
# Endpoint S3 API (substitua ACCOUNT_ID pelo ID da conta Cloudflare)
R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"

R2_ACCESS_KEY_ID="sua_r2_access_key_id"
R2_SECRET_ACCESS_KEY="sua_r2_secret_access_key"
R2_BUCKET_NAME="formalize"

# URL pública base para montar links aos objetos (domínio R2 público ou custom domain, sem barra final)
# Ex.: https://pub-xxxxx.r2.dev  ou  https://cdn.seudominio.com.br
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev"

# ----------------------------------------------------------
# Google OAuth (opcional — se não configurado, botão Google fica oculto)
# ----------------------------------------------------------
# GOOGLE_CLIENT_ID="seu_google_client_id"
# GOOGLE_CLIENT_SECRET="seu_google_client_secret"
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="true"

# ----------------------------------------------------------
# Suporte (opcional — aparece no footer do admin e na página de esqueci senha)
# ----------------------------------------------------------
# NEXT_PUBLIC_SUPPORT_WHATSAPP="+5511999999999"

# ----------------------------------------------------------
# Google Places API (opcional — autocomplete de "local do evento"
# em orçamento/contrato). Sem isso, o campo cai para as opções
# salvas localmente e não sugere endereços do Google.
# Ativar no Google Cloud Console: "Places API" (a clássica, não a
# "Places API (New)") + billing habilitado no projeto.
# Usada só no servidor (app/api/maps/places-autocomplete) — não
# precisa do prefixo NEXT_PUBLIC_.
# ----------------------------------------------------------
# GOOGLE_MAPS_API_KEY="sua_google_places_api_key"

# ----------------------------------------------------------
# Gotenberg (HTML → PDF)
# ----------------------------------------------------------
# GOTENBERG_URL="https://seu-gotenberg.exemplo.com"

# ----------------------------------------------------------
# Desenvolvimento local
# ----------------------------------------------------------
# PORT=3000

# ----------------------------------------------------------
# API WhatsApp
# ----------------------------------------------------------
# URL base da API WhatsApp (sem barra no final)
WHATSAPP_API_URL="https://seu-host-da-api-whatsapp.com"
# userId da instância WhatsApp
WHATSAPP_INSTANCE_USER_ID="gabriel"
# Domínio público para links de reset password
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ----------------------------------------------------------
# Notificações internas
# ----------------------------------------------------------
# Número do WhatsApp do admin para receber alertas de novas solicitações (com DDI, sem +)
ADMIN_NOTIFY_WHATSAPP="5567981783902"
